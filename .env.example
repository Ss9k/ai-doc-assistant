# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=ai_doc_assistant
POSTGRES_PORT=5432
 
# Database URL used by the application
# For Docker Compose (service name 'db'):
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password@db:5432/ai_doc_assistant

#for migrated database
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/ai_doc_assistant_migrations

DATABASE_URL_DOCKER=postgresql+psycopg://postgres:YOUR_PASSWORD@db:5432/ai_doc_assistant

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
